# OCR
OCR_PROVIDER="local" # local | openai | ollama
OCR_MODEL="zai-org/GLM-OCR"
OCR_DEVICE="auto" # auto | cpu | cuda | cuda:0
GLMOCR_LAYOUT_DEVICE="" # optional; example: cpu | cuda | cuda:0
OCR_API_URL="" # openai provider example: http://127.0.0.1:8080/v1/chat/completions
OCR_API_KEY="" # optional external OCR service key
OCR_MAX_WORKERS="8"
OLLAMA_HOST="http://localhost:11434"

# ASR
HF_TOKEN="" # optional; required for downloading gated Pyannote models
ASR_MAX_NEW_TOKENS="512"
ASR_ATTN_IMPLEMENTATION="" # optional: eager | sdpa | flash_attention_2
ASR_MAX_UPLOAD_MB="2048"
ASR_TASK_TIMEOUT_SECONDS="14400"

# Authentication & Email OTP
SECRET_KEY="your_super_secret_jwt_key_here" # replace with at least 32 random characters
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465" # Gmail SSL: 465; STARTTLS: 587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-google-app-password"
SMTP_FROM_EMAIL="noreply@your-domain.com"
