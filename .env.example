# LLM API Keys
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# OCR (default: model runs directly inside this project; Ollama is optional)
OCR_PROVIDER="local" # local | openai | ollama
OCR_MODEL="zai-org/GLM-OCR"
OCR_DEVICE="auto" # auto | cpu | cuda | cuda:0
GLMOCR_LAYOUT_DEVICE="" # optional: cpu | cuda | cuda:0
OCR_API_URL="http://127.0.0.1:8080/v1/chat/completions" # vLLM/SGLang
OCR_API_KEY=""
OCR_MAX_WORKERS="8"
OLLAMA_HOST="http://localhost:11434" # only used when OCR_PROVIDER=ollama

# ASR Models (e.g., Pyannote speaker diarization)
HF_TOKEN=""
ASR_MAX_NEW_TOKENS="512" # 每個 60 秒分段的輸出上限
ASR_ATTN_IMPLEMENTATION="" # 可選: flash_attention_2（需另行安裝相容的 flash-attn）

# Authentication & Email OTP
SECRET_KEY="your_super_secret_jwt_key_here"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-google-app-password"
SMTP_FROM_EMAIL="noreply@your-domain.com"
